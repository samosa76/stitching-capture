# ADAM-6250 connection
ADAM_IP=192.168.18.212
ADAM_PORT=502

# Coil addresses for DO0 / DO1 — verify against your ADAM-6250's Modbus
# address map (manual), these are just common defaults.
DO2_ADDRESS=18
DO3_ADDRESS=19

# Physical distance (meters) between sensor 1 and sensor 2 — measure
# this in the field once real sensors are installed. For now, whatever
# gap you're pretending they're spaced at while simulating with DO0/DO1.
SENSOR_DISTANCE_M=1.0

# How far (in meters) the truck should travel between each capture.
# Smaller = more overlap/more frames, larger = fewer frames but risk
# of gaps at high speed. Tune once you know the camera's real coverage.
CAPTURE_ADVANCE_DISTANCE_M=0.5

# How often (seconds) to poll the ADAM over Modbus
POLL_INTERVAL_S=0.1

# Safety floor so a very high calculated speed never demands an
# unrealistically tiny capture interval
MIN_CAPTURE_INTERVAL_S=0.05

# --- Camera settings (used by camera/main.py) ---
CAMERA_USER=admin
CAMERA_PASS=P4ssw0rd
CAMERA_CHANNEL=101
SAVE_DIR=./captures
CAMERA_1_IP=192.168.18.127

# --- Stitching (used by stitching/main.py) ---
# Fraction to crop off EACH side of every frame before stitching. 0.25
# cuts 1/4 off the front and 1/4 off the back, keeping the middle 50%.
# For a clean stitch with no gaps or leftover overlap, this should match
# CAPTURE_ADVANCE_DISTANCE_M being set to roughly half the camera's real
# -world frame width at the container's distance from the camera.
STITCH_CROP_FRACTION=0.25

# Delete the individual raw frames once stitching succeeds, keeping only
# the final {camera_id}_stitched.jpg. Set to false to keep raw frames
# around too (useful while you're still checking the stitch looks right).
STITCH_CLEANUP_FRAMES=true